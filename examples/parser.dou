import lexer.{TokenParser};
import regex.*;

export fn start() {
   Statement::parse("true");
}

@node
enum Statement {
   Literal(literal: Literal),
}

@node
enum Literal {
   Boolean(boolean: Boolean),
   Number(number: Number),
}

@leaf(regex: r"true|false")
struct Boolean {
   value: bool,
}

impl Boolean for TokenParser {
   fn parse-token(input &String, parser: &mut Parser) -> Option<@self> {
      Some(Boolean { value: input == "true" })
   }
}

@leaf(regex: r"[0-9]+(\.[0-9]+)?")
struct Number {
   value: f64,
}

macro node(res-enum: ResolvedEnum) -> ResolvedItem {
   let leafs = res-enum?.field
      .map(fn(field) {
         @assert-equal(fields.len, 1);

         let field = fields[0];
         let leaf = field.ident.resolve().as-leaf()?;

         let regex = leaf.meta
            .get("regex")
            .expect("missing regex attribute")?
            .as-string()?;
      })
      .collect();

   let regex = @format("({})", leafs.join("|"));
   let regex = Regex::new(regex).unwrap();



   res-enum.extend(parser);

   return res-enum;
}

macro leaf(res-struct: ResolvedStruct) -> ResolvedItem {
   res-struct.type.satisfies<TokenParser>()?;

   return res-struct;
}
