struct Vec<T> {
    ptr: raw T,
    length: usize,

    fn get(self, index: integer in self.length) {
        ptr.offset(index) as index in self.ptr
    }
}

fn PairedVector(a)

fn collatz() {
    let n = 100

    n = match n % 2 {
        0 => n / 2
        1 => 3 * n + 1
    }
}

fn fib(n: integer) -> integer {
    match n {
        0 or 1 => 1,
        _ => fib(n - 1) + fib(n - 2),
    }
}
fn fib(n: integer) -> integer {
    match n {
        0 or 1 => 1,
        _ => fib(n - 1) + fib(n - 2),
    }
}

fn factorial(n: integer) -> integer {
    match n {
        // 0 => 1,
        // 1 => 1,
        _ => n * factorial(n - 1),
    }
}
