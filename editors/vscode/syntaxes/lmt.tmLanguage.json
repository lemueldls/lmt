{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LMT",
  "scopeName": "source.lmt",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#holes"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lmt",
          "match": "//.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.lmt",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lmt",
          "match": "\\b(if|else|match|and|or|not)\\b"
        },
        {
          "name": "keyword.declaration.lmt",
          "match": "\\b(let|use)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lmt",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lmt",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lmt",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.lmt",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.lmt",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.lmt",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.assignment.lmt",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.lmt",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.lmt",
          "match": "\\+|-|\\*|/|%|\\^"
        },
        {
          "name": "keyword.operator.ascription.lmt",
          "match": "::"
        },
        {
          "name": "keyword.operator.type.lmt",
          "match": "\\||&|:"
        },
        {
          "name": "keyword.operator.accessor.lmt",
          "match": "\\."
        }
      ]
    },
    "holes": {
      "patterns": [
        {
          "name": "keyword.other.hole.lmt",
          "match": "\\?\\?|\\?"
        }
      ]
    }
  }
}
