// A launch configuration that compiles the extension and then opens it inside a new window
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Launch Language Server",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceRoot}/crates/bin/lsp"
      ],
      "outFiles": [
        "${workspaceRoot}/crates/bin/lsp/client/out/**/*.js"
      ],
      "preLaunchTask": {
        "type": "npm",
        "script": "esbuild",
        "path": "crates/bin/lsp"
      },
      "env": {
        "SERVER_PATH": "${workspaceRoot}/target/debug/lmt-lsp"
      }
    },
    {
      "name": "Language Server E2E Test",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceRoot}/crates/bin/lsp",
        "--extensionTestsPath=${workspaceRoot}/crates/bin/lsp/client/out/test/index",
        "${workspaceRoot}/crates/bin/lsp/client/testFixture"
      ],
      "outFiles": [
        "${workspaceRoot}/crates/bin/lsp/client/out/test/**/*.js"
      ]
    }
  ]
}